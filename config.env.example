# Copy to config.env (git-ignored) and fill in. Secrets stay in files or in your shell, never in this repo.

# --- Splunk search head (where the AI Toolkit runs) -----------------------------------------------------------------
SPLUNK_WEB_URL=https://splunk.example.com:8000      # Splunk Web, as you open it in a browser
SPLUNK_CREDS_FILE=~/.splunk_creds                   # line 1 = admin user, line 2 = password (chmod 600)
SPLUNK_VERIFY_TLS=true                              # false only for a self-signed certificate

# --- Splunk Observability Cloud -----------------------------------------------------------------------------------
O11Y_REALM=us1                                      # your realm: us0, us1, eu0, au0, jp0 ...
O11Y_ORG_ID=                                        # your org id (Settings > Organization), used by step 5 only
O11Y_TOKEN_FILE=~/.o11y_token                       # an API (read) token, first line of the file
O11Y_ENVIRONMENT=prod                               # APM environment the agent may look at (deployment.environment)
O11Y_DETECTOR_PREFIX=                               # optional: only detectors whose name starts with this
O11Y_MCP_URL=https://region-pdx10.api.scs.splunk.com/system/mcp-gateway/v1/
O11Y_TOOL_SETS=apm,metrics,detectors,dashboards

# --- Splunk logs through the Splunk MCP Server app (optional, recommended) ------------------------------------------
SPLUNK_MCP_URL=                                     # e.g. https://splunk.example.com:8089/services/mcp ; empty = skip
SPLUNK_MCP_TOKEN_FILE=~/.splunk_mcp_token           # encrypted token from the MCP Server app, for a read-only user
LOG_INDEX=main                                      # index with your application logs
LOG_SCHEMA=each event has the service in `source`; search errors with severity or log level fields   # one line telling the agent how your logs look

# --- The agent ------------------------------------------------------------------------------------------------------
AGENT_NAME=SREAgent                                 # letters and digits only (Launchpad rejects "-" and "_")
PLATFORM_DESCRIPTION=a web platform                 # one line about what you run, used in the prompt
LLM_CONNECTION=splunk_hosted_gpt_oss_120b           # name of an LLM connection you created in AI Toolkit > Connections
LLM_PROVIDER=Splunk Hosted Models                   # as shown on that connection
LLM_MODEL=OpenAI GPT-OSS 120B                       # as shown on that connection (Claude: claude-sonnet-4-5-20250929)
AGENT_TIMEOUT_S=900

# --- Names of the objects the quick start creates -------------------------------------------------------------------
O11Y_MCP_CONNECTION=o11y_cloud
SPLUNK_MCP_CONNECTION=splunk_logs
ALERT_NAME=SRE agent - investigate detector alerts
ML_ALERT_NAME=SRE agent - ML anomaly
DETECTOR_ALERT_INDEX=main                           # index where Observability Cloud sends detector alerts (step 4)
